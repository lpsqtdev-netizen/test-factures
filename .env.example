# Required to enable the API and create the initial administrator session.
# Use a unique password of at least 16 characters and keep this file out of version control.
PETAL_ADMIN_EMAIL=admin@example.com
PETAL_ADMIN_PASSWORD=REPLACE-WITH-A-UNIQUE-STRONG-PASSWORD
# Optional: set this when storing data outside the default ./data/store.json path.
# PETAL_STORE_PATH=/app/data/store.json
# Optional: defaults to 3000.
# PORT=3000
